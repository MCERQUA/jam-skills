#!/usr/bin/env bash
# mesh-claim.sh — an exclusive, expiring, owned claim on an arbitrary key.
#
# WHY (2026-08-29): jambot-notify.sh deliberately fans every ops alert to BOTH host@mesh and
# sms-host, and they collided on one ticket (three lanes edited one client file inside 11
# minutes). I "fixed" that in 58b42729 by printing a CLAIM BEFORE ACTIONING banner into every
# alert — telling agents to run `mesh-task-claim lock <key>`.
#
# THAT COMMAND DOES NOT EXIST. `mesh-task-claim` accepts {claim,complete,list,list-claimed,show}
# and operates on QUEUE DIRECTORIES, not arbitrary keys — so it could not have done the job even
# with the right verb. 12 alerts shipped carrying an instruction that errors out. I wrote a guard
# and never ran the command I told everyone else to run.
#
# CLAUDE.md states what a real claim needs, all four; this implements exactly that:
#   1. written BEFORE the work starts   -> the caller runs this first, and acts only on exit 0
#   2. ATOMIC                           -> mkdir(2) is atomic on POSIX; check-then-write races
#   3. an OWNER                         -> AGENT_URI + host + pid recorded inside
#   4. an EXPIRY                        -> stale claims are reaped, so a dead holder cannot
#                                          wedge a key forever (the open-ended-hold trap)
#
# Lives on /mnt/agent-mesh so it works across containers, not just this host.
#
# Usage:
#   mesh-claim.sh take <key> [ttl_seconds]   exit 0 = yours · 2 = held by someone else
#   mesh-claim.sh release <key>              only the owner may release
#   mesh-claim.sh show <key>
set -uo pipefail

# ROOT RESOLUTION (2026-08-30). The host sees the mesh at /mnt/agent-mesh/mesh; a DESK
# CONTAINER sees the same tree bind-mounted at /mesh (`/mnt/agent-mesh/mesh -> /mesh`), and
# /mnt/agent-mesh does not exist there at all. Hardcoding the host path made every desk
# unable to claim — josh-desktop reported it could not adopt the `done` verb because the
# script was not reachable, which is how this was found.
#
# MUST NOT `mkdir -p` its way to a working directory: a container-local CLAIMS dir would let
# `take` SUCCEED while being invisible to every other agent — a lock that reports mutual
# exclusion and provides none. Measured: a probe of mine created exactly that in two desks
# before it was removed.
ROOT="${MESH_CLAIM_ROOT:-}"
if [ -z "$ROOT" ]; then
  if   [ -d /mnt/agent-mesh/mesh ]; then ROOT=/mnt/agent-mesh/mesh/CLAIMS
  elif [ -d /mesh ];               then ROOT=/mesh/CLAIMS
  else
    echo "mesh-claim: FATAL — no shared mesh dir found (/mnt/agent-mesh/mesh or /mesh)." >&2
    echo "mesh-claim: refusing to claim against a path only this process can see." >&2
    exit 70
  fi
fi
mkdir -p "$ROOT" 2>/dev/null   # safe: parent is proven-shared above, never invented here
DEFAULT_TTL="${MESH_CLAIM_TTL:-1800}"          # 30 min: long enough for real work, short
                                               # enough that a dead holder frees the key
cmd="${1:-}"; key="${2:-}"
[ -n "$cmd" ] || { echo "usage: mesh-claim.sh {take|release|done|show|reap} <key> [ttl|note]; reap needs no real key (pass 'all')" >&2; exit 64; }
# reap is a global sweep — key is ignored; all other verbs require it
[ "$cmd" = "reap" ] || [ -n "$key" ] || { echo "usage: mesh-claim.sh {take|release|done|show} <key> [ttl|note]; reap: mesh-claim.sh reap [all]" >&2; exit 64; }
safe=$(printf '%s' "$key" | tr -c 'A-Za-z0-9._:-' '_')
dir="$ROOT/$safe.claim"
done_dir="$ROOT/$safe.done"   # COMPLETION marker: survives release, so a later
                              # taker can see the work was already finished (2026-08-30)
# An owner field that reads "unknown@mesh" satisfies the LETTER of requirement 3 (an OWNER, so a
# human can find them) and defeats its PURPOSE: nobody can be found. Measured 2026-08-29 — host took
# a real ops claim in a shell where AGENT_URI was not exported and the claim recorded unknown@mesh.
# A claim nobody can be traced to is exactly the invisible-holder problem claims exist to end, so
# this REFUSES rather than defaulting. Same principle as promises refusing on an empty Timezone
# instead of assuming UTC: a guard that fills in a plausible value for missing input is not a guard.
if [ -z "${AGENT_URI:-}" ]; then
    echo "mesh-claim: AGENT_URI is not set — refusing to take a claim nobody can be traced to." >&2
    echo "  export AGENT_URI=<you>@mesh   (it does not survive between shells)" >&2
    exit 3
fi
me="$AGENT_URI"
mkdir -p "$ROOT" 2>/dev/null

reap_if_stale() {
    [ -d "$dir" ] || return 0
    local born ttl now
    born=$(cat "$dir/born" 2>/dev/null || echo 0)
    ttl=$(cat "$dir/ttl" 2>/dev/null || echo "$DEFAULT_TTL")
    # sms-host@mesh added the |'' arm (msg 634) and host CLOBBERED it minutes later by
    # reinstalling over the patched copy — restored here. Empty born/ttl contains no
    # non-digit character, so `*[!0-9]*` does NOT match it and an EMPTY value fell through
    # to arithmetic as 0, making `now - 0 >= 0` true and reaping a malformed claim that
    # nobody could evaluate. A claim you cannot read is CANNOT-TELL, not expired.
    case "$born$ttl" in (*[!0-9]*|'') return 0 ;; esac
    now=$(date +%s)
    if [ $(( now - born )) -ge "$ttl" ]; then
        echo "mesh-claim: reaping EXPIRED claim on '$key' (held by $(cat "$dir/owner" 2>/dev/null), age $(( now - born ))s >= ttl ${ttl}s)" >&2
        rm -rf "$dir" 2>/dev/null
    fi
}

case "$cmd" in
  take)
    ttl="${3:-$DEFAULT_TTL}"
    # PREVIOUSLY-COMPLETED WARNING (2026-08-30). A released claim is indistinguishable from one
    # nobody ever took, so a FINISHED task looks exactly like an untouched one. Measured near-miss:
    # host claimed an inbox item, resolved it, released — and sms-host@mesh (which shares the host
    # inbox) escalated the SAME item as still-open 30 min later, on the brink of restarting a lane
    # that was by then healthy and mid-work. The item never changes to say "resolved"; the
    # resolution lives in a different message, and an inbox item has no back-reference to it.
    # Deliberately a WARNING, not a refusal: work can legitimately recur, and making take refuse
    # would break every `take || exit 0` caller. Exit codes unchanged.
    if [ -d "$done_dir" ]; then
      printf 'mesh-claim: ALREADY COMPLETED — %s by %s at %s\n' "$key" \
        "$(cat "$done_dir/owner" 2>/dev/null)" "$(cat "$done_dir/at" 2>/dev/null)" >&2
      [ -s "$done_dir/note" ] && printf 'mesh-claim:   note: %s\n' "$(cat "$done_dir/note")" >&2
      printf 'mesh-claim:   RE-MEASURE THE SUBJECT before acting — the item describes the past.\n' >&2
    fi
    reap_if_stale
    # THREE VERDICTS. A bare `mkdir` failure used to fall through to "held by someone else",
    # so an UNREACHABLE claims root read as HELD and every agent stood down forever on a
    # broken tool. Distinguish them before interpreting the failure.
    if [ ! -d "$ROOT" ] || [ ! -w "$ROOT" ]; then
      echo "mesh-claim: FATAL — claims root '$ROOT' missing or not writable. This is NOT 'held'." >&2
      exit 70
    fi
    if mkdir "$dir" 2>/dev/null; then       # ATOMIC: only one caller can win this
        printf '%s\n' "$me" > "$dir/owner"
        printf '%s\n' "$(date +%s)" > "$dir/born"
        printf '%s\n' "$ttl" > "$dir/ttl"
        # NOT A LIVENESS SIGNAL. $$ is THIS helper's pid and the helper exits on the next
        # line, so the recorded pid is dead within milliseconds of every claim being taken.
        # "the holder's pid is dead" is therefore true of EVERY claim, always, and carries
        # zero information. Liveness is the TTL and only the TTL. Measured 2026-08-30 after
        # a coder session read this field as an orphan signal and RELEASED a live claim that
        # had 35 minutes left, putting two sessions on one task.
        printf '%s taken-by-helper-pid=%s (ALWAYS DEAD, NOT the holder — liveness is the TTL)\n' "$(hostname)" "$$" > "$dir/where"
        echo "mesh-claim: TAKEN '$key' by $me (ttl ${ttl}s)"
        exit 0
    fi
    echo "mesh-claim: HELD '$key' by $(cat "$dir/owner" 2>/dev/null || echo '?') since $(date -u -d "@$(cat "$dir/born" 2>/dev/null || echo 0)" +%H:%M:%SZ 2>/dev/null) — STAND DOWN" >&2
    exit 2 ;;
  release)
    # Root-reachability guard (2026-08-30, josh-desktop). take and show had this; release
    # and done did NOT — and `done` was the worst of the four: every write failed with
    # "No such file or directory" and it still printed "(claim released, completion
    # recorded)" and exited 0. A verb that reports success on total failure is the exact
    # defect this tool exists to prevent, so all four verbs now share one check.
    if [ ! -d "$ROOT" ] || [ ! -w "$ROOT" ]; then
      echo "mesh-claim: FATAL — claims root '$ROOT' missing or not writable. Nothing was recorded." >&2
      exit 70
    fi

    [ -d "$dir" ] || { echo "mesh-claim: '$key' not held"; exit 0; }
    owner=$(cat "$dir/owner" 2>/dev/null)
    if [ "$owner" != "$me" ]; then
        echo "mesh-claim: REFUSING — '$key' is held by $owner, not $me" >&2; exit 3
    fi
    rm -rf "$dir" 2>/dev/null && echo "mesh-claim: released '$key'"; exit 0 ;;
  done)
    # Root-reachability guard (2026-08-30, josh-desktop). take and show had this; release
    # and done did NOT — and `done` was the worst of the four: every write failed with
    # "No such file or directory" and it still printed "(claim released, completion
    # recorded)" and exited 0. A verb that reports success on total failure is the exact
    # defect this tool exists to prevent, so all four verbs now share one check.
    if [ ! -d "$ROOT" ] || [ ! -w "$ROOT" ]; then
      echo "mesh-claim: FATAL — claims root '$ROOT' missing or not writable. Nothing was recorded." >&2
      exit 70
    fi

    # Mark a key COMPLETED and release it in one step. Refuses to mark someone else's live claim.
    if [ -d "$dir" ]; then
      _o=$(cat "$dir/owner" 2>/dev/null)
      if [ -n "$_o" ] && [ "$_o" != "$me" ]; then
        echo "mesh-claim: REFUSING — '$key' is held by $_o, not $me" >&2; exit 3
      fi
    fi
    # TWO DEFECTS FIXED 2026-08-30, both found by josh-desktop and reproduced by bun-desktop.
    #
    # (1) ATTRIBUTION WAS OVERWRITABLE BY ANYONE. Reproduced: alice@mesh completed a key, then
    #     mallory@mesh ran `done` on it and the record read owner=mallory with mallory's note.
    #     The completion record is precisely what a later taker trusts ("ALREADY COMPLETED by X
    #     at T"), so a forgeable one is worse than none. FIRST completion is now IMMUTABLE for
    #     owner/at/note; every completion — including the first — appends to `history`, so
    #     legitimately recurring work is still recorded without destroying who did it first.
    #
    # (2) IT REPORTED SUCCESS ON TOTAL WRITE FAILURE. The earlier root guard only proved the
    #     ROOT was writable; if the .done path itself could not be created (e.g. a FILE sits
    #     where the dir belongs) every write failed and it still printed "(completion recorded)"
    #     and exited 0. Writes are now VERIFIED before the success line is printed.
    _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    if [ -e "$done_dir" ] && [ ! -d "$done_dir" ]; then
      echo "mesh-claim: FATAL — '$done_dir' exists and is not a directory. Nothing recorded." >&2; exit 70
    fi
    if ! mkdir -p "$done_dir" 2>/dev/null; then
      echo "mesh-claim: FATAL — could not create completion record for '$key'. Nothing recorded." >&2; exit 70
    fi
    _prev=$(cat "$done_dir/owner" 2>/dev/null || true)
    if [ -n "$_prev" ] && [ "$_prev" != "$me" ]; then
      printf '%s  %s  (repeat; original completion by %s stands)\n' "$_ts" "$me" "$_prev" >> "$done_dir/history"
      echo "mesh-claim: '$key' was ALREADY COMPLETED by $_prev — recorded your repeat in history, original attribution preserved" >&2
      rm -rf "$dir" 2>/dev/null
      exit 0
    fi
    printf '%s\n' "$me" > "$done_dir/owner" || { echo "mesh-claim: FATAL — write failed, nothing recorded." >&2; exit 70; }
    printf '%s\n' "$_ts" > "$done_dir/at"   || { echo "mesh-claim: FATAL — write failed, nothing recorded." >&2; exit 70; }
    [ -n "${3:-}" ] && { printf '%s\n' "$3" > "$done_dir/note" || { echo "mesh-claim: FATAL — note write failed." >&2; exit 70; }; }
    printf '%s  %s\n' "$_ts" "$me" >> "$done_dir/history" 2>/dev/null
    # VERIFY before claiming success — the whole point of (2).
    if [ ! -s "$done_dir/owner" ] || [ ! -s "$done_dir/at" ]; then
      echo "mesh-claim: FATAL — completion record did not persist for '$key'. Claim NOT released." >&2; exit 70
    fi
    rm -rf "$dir" 2>/dev/null
    echo "mesh-claim: DONE '$key' by $me (claim released, completion recorded)"; exit 0 ;;
  reap)
    # GLOBAL SWEEP (2026-08-30, josh-desktop). reap_if_stale only ever ran inside `take`, on
    # that ONE key — so an expired claim sits on the board until somebody happens to take the
    # same key again. Measured: 3 of 5 claims expired, two of them by 18h and 23.6h. Anyone
    # counting directory entries (as I did — I reported "6 live claims" from `ls`) reads stale
    # locks as live work and gates real decisions on them. Removes ONLY past-TTL claims, which
    # is exactly what reap_if_stale already does per-key; live claims are untouched.
    # `<key>` is ignored for this verb — pass `all`.
    if [ ! -d "$ROOT" ] || [ ! -w "$ROOT" ]; then
      echo "mesh-claim: FATAL — claims root '$ROOT' missing or not writable. Nothing was reaped." >&2
      exit 70
    fi
    _now=$(date +%s); _reaped=0; _kept=0; _cant=0
    for _d in "$ROOT"/*.claim; do
      [ -d "$_d" ] || continue
      _b=$(cat "$_d/born" 2>/dev/null || echo 0); _t=$(cat "$_d/ttl" 2>/dev/null || echo "$DEFAULT_TTL")
      # CANNOT-TELL claims are not live — count them separately so the summary stays honest
      case "$_b$_t" in (*[!0-9]*|'') _cant=$((_cant+1)); continue ;; esac
      if [ $(( _now - _b )) -ge "$_t" ]; then
        printf "mesh-claim: reaped EXPIRED %s (owner=%s, %ss past ttl)\n" \
          "$(basename "$_d" .claim)" "$(cat "$_d/owner" 2>/dev/null)" "$(( _now - _b - _t ))"
        rm -rf "$_d" 2>/dev/null && _reaped=$((_reaped+1))
      else _kept=$((_kept+1)); fi
    done
    echo "mesh-claim: reap complete — $_reaped expired removed, $_kept live kept, $_cant unevaluable"; exit 0 ;;
  show)
    # THREE VERDICTS, NOT TWO (2026-08-30, foamology-coder #507 -> host verified).
    # `show` used to print the same shape and exit 0 for a LIVE claim and an EXPIRED
    # one. reap_if_stale runs ONLY inside `take`, on that exact key — so an expired
    # claim sits on the board looking identical to a held one until somebody happens
    # to take the same key. A reader cannot tell "held" from "stale", which is the
    # missing-third-verdict bug. Same arithmetic as reap_if_stale on purpose.
    # Exit: 0 = LIVE (stand down) · 1 = free · 2 = EXPIRED (reapable, not a live hold).
    # Same three-verdict rule as `take` (bun-desktop caught this: I hardened take and left
    # show reporting "free" on an unreachable root — a reader would conclude the key is
    # AVAILABLE when the truth is that nothing can be known about it). CANNOT-TELL is not free.
    if [ ! -d "$ROOT" ] || [ ! -w "$ROOT" ]; then
      echo "mesh-claim: FATAL — claims root '$ROOT' missing or not writable. Cannot tell whether '$key' is held." >&2
      exit 70
    fi
    # A key that was COMPLETED and released reports "free" — true, but it loses the one fact a
    # reader most needs: somebody already did this. `take` warns; `show` was silent, so anyone
    # checking before acting got no hint. Surfaced here too. (2026-08-30, found by my own test.)
    if [ ! -d "$dir" ] && [ -d "$done_dir" ]; then
      printf "mesh-claim: '%s' free — but COMPLETED by %s at %s\n" "$key" \
        "$(cat "$done_dir/owner" 2>/dev/null)" "$(cat "$done_dir/at" 2>/dev/null)"
      [ -s "$done_dir/note" ] && printf "mesh-claim:   note: %s\n" "$(cat "$done_dir/note")"
      exit 1
    fi
    [ -d "$dir" ] || { echo "mesh-claim: '$key' free"; exit 1; }
    _b=$(cat "$dir/born" 2>/dev/null || echo 0)
    _t=$(cat "$dir/ttl" 2>/dev/null || echo "$DEFAULT_TTL")
    _n=$(date +%s); _verdict="UNKNOWN-ttl"; _rc=0
    case "$_b$_t" in
      (*[!0-9]*) : ;;
      (*) if [ $(( _n - _b )) -ge "$_t" ]; then
            _verdict="EXPIRED (reapable, age $(( _n - _b ))s >= ttl ${_t}s)"; _rc=2
          else
            _verdict="LIVE ($(( _b + _t - _n ))s left)"; _rc=0
          fi ;;
    esac
    echo "mesh-claim: '$key' $_verdict owner=$(cat "$dir/owner" 2>/dev/null) born=$_b ttl=$_t at=$(cat "$dir/where" 2>/dev/null)"
    exit $_rc ;;
  *) echo "usage: mesh-claim.sh {take|release|done|show|reap} <key> [ttl|note]" >&2; exit 64 ;;
esac
