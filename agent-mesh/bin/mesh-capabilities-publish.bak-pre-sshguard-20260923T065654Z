#!/usr/bin/env python3
"""mesh-capabilities-publish — auto-detect agent capabilities and write/update
/mesh/REGISTRY/<agent>-CAPABILITIES.md.

Auto-detects: installed interpreters + versions, pip packages (from uv/pip),
npm package manifests under /config/, any UPGRADES/ entries, GPU access.
Falls back to host-relay via /peer-inbox/host/ if REGISTRY is ro.

Stdlib + subprocess only.

Usage:
    mesh-capabilities-publish [--max-parallel N] [--special-access a,b] [--dry-run]

Exit codes:
    0  success
    1  AGENT_URI not set or write failed with no relay path
"""
from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

_lib = Path(__file__).resolve().parent.parent / "lib"
if str(_lib) not in sys.path:
    sys.path.insert(0, str(_lib))
from intel_filter import enforce as _intel_enforce  # noqa: E402  SEC-032 fail-closed gate


# NO DEFAULT IDENTITY. This file was canonicalised from danielle-desktop's fork on
# 2026-09-06 and carried its personal fallback with it; as a shared binary that made
# EVERY desk publish as danielle-desktop whenever AGENT_URI was unset — writing another
# agent's REGISTRY entry and relaying mail under their name. Flagged by josh-desktop
# within minutes of the graft. An unset identity is undecidable, never guessable.
AGENT_URI = os.environ.get("AGENT_URI") or ""
if not AGENT_URI:
    sys.exit("mesh-capabilities-publish: AGENT_URI env var required — refusing to guess an identity")
if not AGENT_URI.endswith("@mesh"):
    sys.exit(f"mesh-capabilities-publish: AGENT_URI must end with @mesh, got: {AGENT_URI}")
# str.replace is GLOBAL, so this also normalises a doubled @mesh@mesh suffix.
AGENT_NAME = AGENT_URI.replace("@mesh", "")
if not AGENT_NAME:
    sys.exit(f"mesh-capabilities-publish: AGENT_URI has no agent name: {AGENT_URI}")
REGISTRY_DIR = Path("/mesh/REGISTRY")
UPGRADES_DIR = Path("/mesh/UPGRADES")


def run(cmd: list[str], **kw) -> str:
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True, **kw).strip()
    except Exception:
        return ""


def detect_languages() -> list[dict]:
    langs = []
    seen_paths: set[str] = set()
    for interp in ("python3.13", "python3", "node", "ruby", "go"):
        path = _which(interp)
        if not path:
            continue
        if path in seen_paths:
            continue
        seen_paths.add(path)
        # Invoke the RESOLVED path, not the bare name: run(["python3.13", ...])
        # goes back through the ambient PATH, so a desk that HAS the interpreter
        # reported an empty version from any shell that could not see it — the
        # last caller-dependent field after the lookup itself was fixed.
        ver = run([path, "--version"])
        langs.append({"name": interp, "version": ver, "path": path})
    # bun may live outside PATH at a known location
    for bun_path in (_which("bun"), "/config/mesh-tools/bin/bun/bun"):
        if bun_path and Path(bun_path).is_file() and bun_path not in seen_paths:
            seen_paths.add(bun_path)
            ver = run([bun_path, "--version"])
            langs.append({"name": "bun", "version": ver, "path": bun_path})
            break
    _bash = _which("bash")
    if _bash:
        langs.append({"name": "bash", "version": run([_bash, "--version"]).splitlines()[0],
                      "path": _bash})
    return langs


def detect_tools() -> list[str]:
    tools = []
    for tool in ("ffmpeg", "chromium", "chromium-browser", "google-chrome",
                 "xdotool", "convert", "curl", "jq", "git", "gh", "docker", "npx"):
        if _which(tool):
            tools.append(tool)
    # ovui-bridge present if the config dir exists
    if Path("/config/ovui-bridge").is_dir():
        tools.append("ovui-bridge")
    # playwright usable from agent-venv
    venv_py = Path("/config/agent-venv/bin/python3.13")
    if venv_py.exists():
        result = run([str(venv_py), "-c", "import playwright"])
        if result is not None:  # "" means success (no output), None means exception
            try:
                subprocess.check_call([str(venv_py), "-c", "import playwright"],
                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                tools.append("playwright")
            except Exception:
                pass
    # remotion
    if Path("/config/motion-videos/node_modules/remotion").is_dir():
        tools.append("remotion")
    if _which("mesh-send"):
        tools.append("mesh-messaging")
    tools.append("file-editing")
    return sorted(set(tools))


_NPM_SKIP = ("node_modules", ".npm", ".claude", "site-packages", "dist", "driver")


def detect_npm_projects() -> list[str]:
    projects = []
    for pkg_json in Path("/config").rglob("package.json"):
        if any(skip in pkg_json.parts for skip in _NPM_SKIP):
            continue
        try:
            data = json.loads(pkg_json.read_text())
            name = data.get("name", str(pkg_json.parent.name))
            projects.append(name)
        except Exception:
            pass
    return projects


def detect_upgrades() -> list[str]:
    if not UPGRADES_DIR.is_dir():
        return []
    pkgs = []
    for f in UPGRADES_DIR.glob(f"*-{AGENT_NAME}-*.md"):
        for line in f.read_text(errors="replace").splitlines():
            if line.startswith("PACKAGE:") or line.startswith("PACKAGES:"):
                pkgs.append(line.split(":", 1)[1].strip())
    return pkgs


def detect_gpu() -> bool:
    # Absolute lookup: a bare "nvidia-smi" through the ambient PATH makes a GPU
    # claim depend on the caller's shell. This feeds special_access ("gpu"), so a
    # miss silently declares a GPU desk to be GPU-less — a capability LIE that is
    # stable per-caller and therefore never looks like a bug.
    smi = _which("nvidia-smi") or "/usr/bin/nvidia-smi"
    return bool(run([smi]))


# A DESK'S CAPABILITIES ARE A PROPERTY OF THE DESK, NOT OF THE CALLER'S PATH.
# _which() consults the ambient PATH, so the same command answered differently
# from every entry point: a login shell saw python3.13 and gh (they live in
# /config/.local/bin), a docker-exec shell did not, and an interactive shell also saw
# bun (/config/mesh-tools/bin, added by .bashrc). Three entry points, three different
# capability documents for one unchanged machine — which is what kept the desks
# re-publishing: each context read the others' output as a real change.
# Search a fixed, desk-defined path instead. Deterministic by construction.
DESK_PATH = os.pathsep.join((
    "/config/.local/bin",
    "/config/mesh-tools/bin",
    "/config/bin",
    "/config/.bun/bin",
    "/usr/local/sbin", "/usr/local/bin",
    "/usr/sbin", "/usr/bin",
    "/sbin", "/bin",
    "/lsiopy/bin",
))


def _which(cmd: str) -> str | None:
    """PATH-independent lookup. Deliberately does NOT fall back to the ambient PATH:
    a fallback would reintroduce exactly the caller-dependence this exists to remove.

    Returns the DESK_PATH-selected NAME, deliberately NOT its realpath. Determinism
    comes from DESK_PATH being fixed, and realpath would destroy real information:
    CPython derives sys.prefix from argv[0], not from the inode. On these desks
    /usr/bin/python3 and /lsiopy/bin/python3 are ONE file (inode 27375) that resolves
    two different environments —

        /usr/bin/python3     sys.prefix=/usr      110 distributions
        /lsiopy/bin/python3  sys.prefix=/lsiopy   207 distributions  (aiohttp only here)

    — 97 distributions of difference decided entirely by which name invoked it. An
    earlier revision realpath'd here and would have declared one name while the agent
    imported from the other. Caught by bun-desktop 2026-09-06 after I refuted their
    weaker "different files" claim; the inode was the same, the environment was not.
    """
    return shutil.which(cmd, path=DESK_PATH)


def _find_uv() -> str | None:
    """Resolve uv WITHOUT consulting the ambient PATH.

    _which("uv") made this desk's reported capabilities depend on WHO invoked
    the publisher. Measured on josh-desktop 2026-09-06: uv is at /config/.local/bin/uv,
    which is on the LOGIN PATH but absent from the docker-exec/s6 environment. So the
    keeper found it and reported the venv's packages, while any other entry point missed
    it and fell through to the ambient python3.13 — 1 package. The payload oscillated
    between three hashes depending on the caller, which no single-value change-marker
    can ever converge against: each context sees the other's hash as a change and
    re-publishes forever.
    """
    # /config/mesh-tools/bin is where the REAL binary lives on these desks;
    # /config/.local/bin/uv is a symlink to it and happens to exist today, so
    # omitting the real path worked by luck and would resolve nothing on a desk
    # that lacks the symlink. Caught by bun-desktop 2026-09-06 reviewing a09cc34.
    for cand in ("/config/.local/bin/uv", "/config/mesh-tools/bin/uv",
                 "/usr/local/bin/uv", "/usr/bin/uv",
                 str(Path.home() / ".local/bin/uv")):
        if os.access(cand, os.X_OK):
            return cand
    return _which("uv")


def detect_pip_packages() -> list[str]:
    venv = Path("/config/agent-venv")
    venv_py = venv / "bin/python3.13"
    # If the desk HAS a venv, the venv is the answer — regardless of what the caller's
    # PATH happens to contain. uv is an optimisation, never the thing that decides.
    if venv_py.is_file():
        uv = _find_uv()
        if uv:
            raw = run([uv, "pip", "list", "--python", str(venv_py)])
            if raw:
                pkgs = []
                for line in raw.splitlines()[2:]:
                    parts = line.split()
                    if len(parts) >= 2:
                        pkgs.append(f"{parts[0]}=={parts[1]}")
                return pkgs
        # No uv: ask the venv's OWN interpreter. Still the venv, still deterministic.
        raw = run([str(venv_py), "-m", "pip", "list", "--format=json"])
        if raw:
            try:
                return [f"{q['name']}=={q['version']}" for q in json.loads(raw)]
            except Exception:
                pass
    # Last resort, only reached on a desk with no /config/agent-venv. Bare
    # "python3.13" here went through the ambient PATH: found on one entry point,
    # absent on another, so pip_packages oscillated between a full list and []
    # — the never-converging payload this whole thread is about, surviving one
    # function below the fix. Flagged by bun-desktop 2026-09-06; bun itself never
    # reaches it because its venv exists, which is exactly why it went unnoticed.
    _py313 = _which("python3.13")
    if not _py313:
        return []
    raw = run([_py313, "-m", "pip", "list", "--format=json"])
    if not raw:
        return []
    try:
        return [f"{p['name']}=={p['version']}" for p in json.loads(raw)]
    except Exception:
        return []


def build_doc(langs: list[dict], tools: list[str], npm_projects: list[str],
              pip_pkgs: list[str], upgrades: list[str],
              special_access: list[str], max_parallel: int) -> str:
    ts = _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    def yaml_list(items: list[str], indent: int = 2) -> str:
        if not items:
            return " " * indent + "[]"
        pad = " " * indent
        return "\n".join(f"{pad}- {i}" for i in items)

    lang_items = [f"{l['name']}=={l['version']}" for l in langs]

    return f"""\
---
agent: {AGENT_NAME}@mesh
last_updated: {ts}
languages:
{yaml_list(lang_items)}
tools:
{yaml_list(tools)}
npm_projects:
{yaml_list(npm_projects)}
pip_packages:
{yaml_list(pip_pkgs[:30])}
upgrades_logged:
{yaml_list(upgrades)}
special_access:
{yaml_list(special_access) if special_access else "  []"}
max_parallel_tasks: {max_parallel}
---

# {AGENT_NAME} Capabilities

Auto-generated by mesh-capabilities-publish. Do not edit by hand — re-run to refresh.

## Languages
{chr(10).join(f'- {l["name"]} {l["version"]}  ({l["path"]})' for l in langs)}

## Tools on PATH / detected
{chr(10).join(f'- {t}' for t in tools)}

## npm Projects (under /config/)
{chr(10).join(f'- {p}' for p in npm_projects) or 'none'}

## Special Access
{chr(10).join(f'- {a}' for a in special_access) if special_access else 'none'}
"""


def _relay_to_host(content: str, out_path: Path) -> None:
    """Send capability declaration to host inbox for host to write to REGISTRY.

    Must go through mesh-send (not a direct write into /peer-inbox/host/) so a
    sent/ copy exists — jambot-mesh-audit.sh quarantines any inbox file whose
    AUTHOR has no matching sent/ record, and mesh-send reports success either
    way, so a direct write is a silent-loss path (see 2026-09-06 dead-letter).
    """
    if not _which("mesh-send"):
        sys.exit(f"REGISTRY ro and mesh-send not found — cannot write or relay {out_path}")
    body = (
        f"Please write the following to {out_path} on the host filesystem:\n\n"
        f"```\n{content}```\n"
    )
    _intel_enforce(body, tool="mesh-capabilities-publish")
    # AGENT_URI may carry a doubled @mesh@mesh suffix from an upstream env bug
    # (reported 2026-09-06); pass the clean AGENT_URI explicitly either way.
    env = {**os.environ, "AGENT_URI": f"{AGENT_NAME}@mesh"}
    subprocess.run(
        ["mesh-send", "--to", "host@mesh", "--kind", "attachment",
         "--subject", "capabilities-declaration"],
        input=body, text=True, check=True, env=env,
    )
    print(f"mesh-capabilities-publish: REGISTRY ro — relayed to host via mesh-send")


def main() -> None:
    ap = argparse.ArgumentParser(description="Publish agent capability declaration to mesh REGISTRY")
    ap.add_argument("--max-parallel", type=int, default=3,
                    help="Max concurrent tasks (default: 3)")
    ap.add_argument("--special-access", default="",
                    help="Comma-separated special access flags, e.g. residential-ip,gpu")
    ap.add_argument("--dry-run", action="store_true",
                    help="Print the declaration without writing it")
    args = ap.parse_args()

    special = [s.strip() for s in args.special_access.split(",") if s.strip()]
    if detect_gpu() and "gpu" not in special:
        special.append("gpu")

    langs = detect_languages()
    tools = detect_tools()
    npm_projects = detect_npm_projects()
    pip_pkgs = detect_pip_packages()
    upgrades = detect_upgrades()

    doc = build_doc(langs, tools, npm_projects, pip_pkgs, upgrades, special, args.max_parallel)

    if args.dry_run:
        print(doc)
        return

    out_path = REGISTRY_DIR / f"{AGENT_NAME}-CAPABILITIES.md"

    # Skip entirely when nothing about this desk has CHANGED. Every mesh-on run
    # published unconditionally, and on a read-only /mesh that means a relay message
    # into host's inbox every single run. Measured 2026-09-06: 10 relays that day
    # carried 3 distinct payloads — josh-desktop sent 5 relays of ONE payload, so 7
    # of 10 were pure noise that a human then had to read past. REGISTRY is readable
    # from the desks (only writes are blocked), so the comparison costs nothing.
    # last_updated is excluded because it changes on every run by construction and
    # would defeat the whole check.
    def _sans_ts(text: str) -> str:
        return "\n".join(l for l in text.splitlines() if not l.startswith("last_updated:"))

    # Compare against what THIS DESK LAST PUBLISHED OR RELAYED, held locally — not
    # against the registry copy. Comparing to the registry cannot converge on a
    # read-only /mesh: the relay does not update out_path, the host drain does, up
    # to 15 minutes later, so every run in between re-reads the same stale file,
    # sees a difference and relays again. First attempt at this did exactly that and
    # three consecutive runs all relayed. A local marker is true regardless of how
    # far behind the registry is.
    import hashlib as _hl
    _sig = _hl.sha256(_sans_ts(doc).encode()).hexdigest()
    _state = None
    for _cand in (Path("/agent-desk"), Path.home() / ".cache", Path("/tmp")):
        try:
            _cand.mkdir(parents=True, exist_ok=True)
            if os.access(_cand, os.W_OK):
                _state = _cand / ".mesh-capabilities-last.sha"
                break
        except OSError:
            continue
    if _state is not None and _state.is_file():
        try:
            if _state.read_text().strip() == _sig:
                print("mesh-capabilities-publish: unchanged since last publish — nothing to send")
                return
        except OSError:
            pass  # unreadable marker is not a reason to skip

    _intel_enforce(doc, tool="mesh-capabilities-publish")
    try:
        out_path.write_text(doc)
        print(f"mesh-capabilities-publish: wrote {out_path}")
    except OSError:
        _relay_to_host(doc, out_path)
    if _state is None:
        print("mesh-capabilities-publish: WARNING - no writable location for the unchanged-marker; "
              "every run will re-publish. Checked /agent-desk, ~/.cache, /tmp.", file=sys.stderr)
    else:
        try:
            _state.write_text(_sig + "\n")
        except OSError as e:
            # Do NOT fail silently. Without the marker this de-dupe is inert and the
            # desk relays on every run — which is indistinguishable, from host's side,
            # from a desk whose capabilities genuinely keep changing. Say so.
            print(f"mesh-capabilities-publish: WARNING - could not write {_state} ({e}); "
                  f"unchanged-detection is INERT and this desk will re-publish every run. "
                  f"Check ownership — a marker left root-owned by a `docker exec` from the host "
                  f"cannot be overwritten by the agent user.", file=sys.stderr)


if __name__ == "__main__":
    main()
