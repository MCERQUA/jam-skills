#!/usr/bin/env python3
"""mesh-ack — mark a message as read by moving it to inbox/.read/.

Also appends `# ACKED <ts> <filename>` to the watchdog log for audit.
This is the "trust-the-agent + audit" marker mechanism (PROTOCOL §17).

Stdlib-only.

Env:
    AGENT_URI    required
    MESH_ROOT    optional

Usage:
    mesh-ack <filename>        # mark the named file read
    mesh-ack --all             # mark all currently-unread files read
"""
from __future__ import annotations

import argparse
import datetime as _dt
import os
import re
import sys
from pathlib import Path


def die(msg: str, code: int = 1) -> None:
    print(f"mesh-ack: {msg}", file=sys.stderr)
    sys.exit(code)


def agent_name() -> str:
    uri = os.environ.get("AGENT_URI")
    if not uri:
        die("AGENT_URI env var required")
    if not uri.endswith("@mesh"):
        die(f"AGENT_URI must end with @mesh, got: {uri}")
    return uri[: -len("@mesh")]


def resolve_my_desk_dir() -> Path:
    """Return this agent's own desk-root directory (the dir whose "inbox" and
    other per-desk state actually belong to AGENT_URI), robust to a container
    that bind-mounts MULTIPLE agents' desks at once.

    Resolution order:
      1. MESH_ROOT env override (explicit host-mesh layout).
      2. A desk dir matching this agent's OWN "-desk-<N>" suffix: /agent-desk-<N>
         — checked BEFORE the bare /agent-desk mount, and only trusted if that
         exact numbered dir exists on this container.
      3. /agent-desk — but ONLY when AGENT_URI has NO "-desk-<N>" suffix (the
         single-desk-per-container case, or the primary "-desktop"/base identity
         that legitimately owns /agent-desk even on a dual-mounted container).
      4. Host path /mnt/agent-mesh/agents/<name>.

    Bug fixed 2026-09-09 (measured by josh-desk-1@mesh): webtop-ubuntu-os-josh
    mounts BOTH /agent-desk (josh-desktop's desk) and /agent-desk-1 (josh-desk-1's
    OWN desk). The old code checked Path("/agent-desk").is_dir() first,
    unconditionally, so every "-desk-N" identity sharing that container silently
    read josh-desktop's inbox instead of its own — 21 unacked messages sat
    unread while mesh-recv reported "0 unread drained", and mesh-on / the
    ACTION-prompt relay issued false work orders off the wrong agent's mail.
    """
    override = os.environ.get("MESH_ROOT")
    if override:
        return Path(override) / "agents" / agent_name()

    name = agent_name()
    m = re.match(r"^(.+)-desk-(\d+)$", name)
    if m:
        desk_n_dir = Path(f"/agent-desk-{m.group(2)}")
        if desk_n_dir.is_dir():
            return desk_n_dir
        # A "-desk-N" identity with no matching numbered mount on this container.
        # Do NOT silently fall back to /agent-desk — that is another agent's desk.
    elif Path("/agent-desk").is_dir():
        return Path("/agent-desk")

    if Path("/mnt/agent-mesh").is_dir():
        return Path("/mnt/agent-mesh/agents") / name

    die("cannot discover mesh root — set MESH_ROOT")


def discover_my_inbox() -> Path:
    # MESH_INBOX, when set, names THIS desk's own inbox directly and wins over
    # every path-guessing fallback below (belt-and-suspenders alongside the
    # AGENT_URI desk-N match in resolve_my_desk_dir()).
    inbox_override = os.environ.get("MESH_INBOX")
    if inbox_override:
        return Path(inbox_override)
    return resolve_my_desk_dir() / "inbox"

def log_drop(message: str) -> None:
    for candidate in (
        "/var/log/jambot-mesh-inotify.log",
        "/config/workspace/mesh-events.log",
    ):
        try:
            with open(candidate, "a", encoding="utf-8") as fh:
                fh.write(message + "\n")
            return
        except OSError:
            continue
    # 2026-08-01 (bun-desktop): fail LOUD when EVERY candidate fails. A silent-everywhere
    # logger is indistinguishable from a quiet night — josh-desktop's audit file was
    # root:root and swallowed 13,275 acks while every ack still printed success. The ack
    # itself still succeeds (the file move is what matters); we only surface the audit gap.
    print(f"mesh-ack: WARNING audit log_drop failed on all candidates "
          f"(check perms on /config/workspace/mesh-events.log) — ack recorded, audit line lost",
          file=sys.stderr)


def ack_file(inbox: Path, filename: str) -> bool:
    # 2026-08-01: reduce to a bare basename FIRST. If callers pass an absolute path
    # (e.g. `mesh-ack /mnt/agent-mesh/agents/host/inbox/foo.md`), pathlib's `base / abs`
    # DISCARDS the base and returns `abs` — so `read_dir / filename` pointed back at the
    # ORIGINAL file, `dest.exists()` was true, and the file got renamed in-place to
    # `foo.md.dup-<ts>` in the inbox instead of moving to .read/. That is the dup-file
    # mechanism bun/josh/src reproduced across three desks. Normalizing to .name fixes it.
    filename = Path(filename).name
    src = inbox / filename
    if not src.is_file():
        print(f"mesh-ack: file not found: {filename}", file=sys.stderr)
        return False
    read_dir = inbox / ".read"
    read_dir.mkdir(exist_ok=True, mode=0o755)
    dest = read_dir / filename
    # if an older ack file with the same name exists, keep both
    if dest.exists():
        ts = _dt.datetime.utcnow().strftime("%Y%m%d-%H%M%S")
        dest = read_dir / f"{filename}.dup-{ts}"
    src.rename(dest)
    ts = _dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
    log_drop(f"# ACKED {ts} agent={agent_name()} file={filename}")
    print(f"acked: {filename}")
    return True


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("filename", nargs="?", help="message filename to ack (relative, just base name)")
    p.add_argument("--all", action="store_true", help="ack every currently-unread file in inbox")
    args = p.parse_args()

    inbox = discover_my_inbox()
    if not inbox.is_dir():
        die(f"inbox not found: {inbox}")

    if args.all:
        any_done = False
        for entry in list(inbox.iterdir()):
            if entry.is_file() and entry.suffix == ".md":
                if ack_file(inbox, entry.name):
                    any_done = True
        if not any_done:
            print("(nothing to ack)")
        return

    if not args.filename:
        die("provide a filename, or pass --all")

    if not ack_file(inbox, args.filename):
        sys.exit(2)


if __name__ == "__main__":
    main()
